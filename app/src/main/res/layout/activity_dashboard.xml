<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#1A73E8"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnBack"
            android:text="←"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00000000"
            android:minWidth="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="📊 Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRefresh"
            android:text="🔄"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00000000"
            android:minWidth="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ============================================================
         TAB SWITCHER — Phân tích | Lịch sử
         ============================================================ -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgTabs"
        app:singleSelection="true"
        android:background="#E8EEF9"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabAnalysis"
            android:text="📊 PHÂN TÍCH"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabHistory"
            android:text="📋 LỊCH SỬ"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ============================================================
         CONTENT AREA — 2 tab, chỉ 1 tab visible tại 1 thời điểm
         Cả 2 đều có layout_weight=1 → chiếm toàn bộ không gian còn lại
         ============================================================ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: PHÂN TÍCH (mặc định visible) -->
        <ScrollView
            android:id="@+id/scrollStats"
            android:background="#F0F4FF"
            android:fillViewport="true"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvStats"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="12dp"
                android:textColor="#222222"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!-- TAB 2: LỊCH SỬ (mặc định ẩn) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResults"
            android:background="#FFFFFF"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- ============================================================
         EXPORT — CSV / JSON / Share
         ============================================================ -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnExportCsv"
            android:text="📤 CSV"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnExportJson"
            android:text="📤 JSON"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnShareLast"
            android:text="📲 Share"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ============================================================
         XOÁ — 100 gần nhất / Xoá hết
         ============================================================ -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnDelete100"
            android:text="Xoá 100 gần nhất"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnClearAll"
            android:text="🗑 Xoá hết"
            android:backgroundTint="#D93025"
            android:textColor="#FFFFFF"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
